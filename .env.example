# GEMINI_API_KEY: Required for Gemini AI API calls (injected at runtime in AI Studio)
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=

# FOOTBALL_API_KEY: Key for football-data.org API
FOOTBALL_API_KEY=

# Gmail SMTP Email Verification Service (smtp.gmail.com:465 SSL)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Super Admin Credentials
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Server Session Cryptographic Secret
SESSION_SECRET=
